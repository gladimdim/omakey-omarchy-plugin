#!/usr/bin/env python3
"""Bundle the stock layouts and key labels into docs/assets/layouts.js for the website.

Usage: scripts/site-layouts [path/to/omakey-layout-studio]   (default: ../omakey-layout-studio)
"""
import json, pathlib, sys

here = pathlib.Path(__file__).resolve().parent.parent
studio = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else here.parent / "omakey-layout-studio")
spec = studio / "spec"
order = ["classic-qwerty", "omakey-pro", "classic-colemak", "classic-dvorak", "corne",
         "lily58", "ferris-sweep", "ergodox", "alice", "kinesis-advantage"]
files = {p.stem: p for p in (spec / "layouts").glob("*.json")}
names = order + sorted(set(files) - set(order))
layouts = [json.loads(files[n].read_text()) for n in names if n in files]
codes = json.loads((spec / "keycodes.json").read_text())["keys"]
data = {
    "keycodes": {k["name"]: [k["code"], k["label"]] for k in codes},
    "layouts": layouts,
}
out = here / "docs" / "assets" / "layouts.js"
out.write_text("/* Generated by scripts/site-layouts from omakey-layout-studio/spec. Do not edit. */\n"
               "window.OMK_DATA = " + json.dumps(data, ensure_ascii=False, separators=(",", ":")) + ";\n")
print(f"{out}: {len(layouts)} layouts, {len(codes)} key codes")
